
@typeparam T

<select class="@Class"
        value="@Value"
        @onchange="HandleChange">
    
    @if (!string.IsNullOrEmpty(Placeholder))
    {
        <option value="" disabled selected>@Placeholder</option>
    }
    
    @if (Items != null)
    {
        foreach (T item in Items)
        {
            <option value="@GetItemValue(item)">@GetDisplayText(item)</option>
        }
    }
</select>

