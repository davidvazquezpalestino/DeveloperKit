@typeparam TItem
@typeparam TValue

<select class="@Class" value="@SelectedKey" @onchange="HandleChange">
    
    @if (!string.IsNullOrEmpty(Placeholder))
    {
        <option value="">@Placeholder</option>
    }
    
    @if (Items != null)
    {
        foreach (TItem item in Items)
        {
            <option value="@GetItemKey(item)">@GetDisplayText(item)</option>
        }
    }
</select>
