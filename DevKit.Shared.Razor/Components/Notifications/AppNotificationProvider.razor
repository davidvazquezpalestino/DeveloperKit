
@inject IAppNotification AppNotification
@implements IDisposable

@if (CurrentDialog != null)
{
    <!-- Overlay semitransparente oscuro -->
    <div class="modal fade show d-block"
         style="background-color: rgba(0,0,0,0.5); z-index: 2000;"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="appNotificationDialogTitle"
         aria-describedby="appNotificationDialogBody"
         @onkeydown="OnDialogKeyDown">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content shadow-lg border-0 overflow-hidden rounded-4" style="max-width: 600px;">
                <div class="modal-header @GetHeaderClass(CurrentDialog.Icon) border-0 py-4 px-5">
                    <h5 id="appNotificationDialogTitle" class="modal-title fw-bold m-0 flex-grow-1" style="font-size: 1.25rem;">
                        @GetHeaderIconHtml(CurrentDialog.Icon) @CurrentDialog.Title
                    </h5>
                    @if (CurrentDialog.ShowCancelButton)
                    {
                        <button type="button"
                                class="btn-close @(GetHeaderClass(CurrentDialog.Icon).Contains("text-white") ? "btn-close-white" : "")"
                                @onclick="CancelDialog"
                                aria-label="Cerrar diálogo"></button>
                    }
                </div>
                <div class="modal-body text-center px-5 pb-5 pt-4" id="appNotificationDialogBody">
                    <p class="text-secondary mb-4" style="font-size: 1.2rem; line-height: 1.6;">@CurrentDialog.Message</p>

                    <div class="d-flex justify-content-center gap-3 mt-3">
                        @if (CurrentDialog.ShowCancelButton)
                        {
                            <button type="button" class="btn btn-outline-secondary px-5 py-3 rounded-pill fw-medium" style="min-width: 140px;" @onclick="CancelDialog">
                                @CurrentDialog.CancelButtonText
                            </button>
                        }
                        <button type="button" class="btn @GetButtonClass(CurrentDialog.Icon) px-5 py-3 rounded-pill fw-medium" style="min-width: 140px;" autofocus @onclick="ConfirmDialog">
                            @CurrentDialog.ConfirmButtonText
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2050;" role="region" aria-label="Notificaciones">
    @foreach (ToastItem toast in ActiveToasts.ToList())
    {
        <div class="toast show align-items-center text-bg-@GetToastColor(toast.Icon) border-0 mb-2 shadow-sm"
             role="@GetToastRole(toast.Icon)"
             aria-live="@GetToastLive(toast.Icon)"
             aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fw-medium" style="font-size: 1rem;">
                    @GetToastIconHtml(toast.Icon) @toast.Message
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        @onclick="() => CloseToast(toast)"
                        aria-label="Cerrar notificación"></button>
            </div>
        </div>
    }
</div>