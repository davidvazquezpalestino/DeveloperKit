@typeparam T
@implements IDisposable

<div class="autocomplete-container position-relative">
    <input type="text"
           class="@Class"
           value="@SearchText"
           placeholder="@Placeholder"
           @oninput="HandleInput"
           @onkeydown="HandleKeyDown"
           @onfocus="ShowSuggestions"
           @onblur="HideSuggestionsWithDelay" />

    <span class="input-icon position-absolute top-50 start-0 translate-middle-y ms-3 text-muted" style="font-size: 14px;">
        <i class="bi bi-search" style="font-size: 14px;"></i>
    </span>

    @if (IsDropdownVisible)
    {
        <ul class="dropdown-menu show position-absolute"
            style="min-width: 100%; width: auto; white-space: nowrap;">
            @for (int index = 0; index < Items.Count; index++)
            {
                T option = Items[index];
                <li>
                    <button class="dropdown-item @(index == SelectedIndexField ? "active" : "")"
                            @onclick="() => SelectOption(option)">
                        @DisplayItem(option)
                    </button>
                </li>
            }
        </ul>
    }
</div>

