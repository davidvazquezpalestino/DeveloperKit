<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Title>DevKit.Shared.RazorComponent - Componentes Reutilizables para Blazor</Title>
		<Authors>David Vázquez Palestino</Authors>
		<Company>David Vázquez Palestino</Company>
		<Product>DevKit.Shared.RazorComponent</Product>
		<Description>DotNet.Shared.RazorComponent es una biblioteca de componentes Razor reutilizables para aplicaciones Blazor. Proporciona componentes web modernos y optimizados para facilitar el desarrollo de interfaces de usuario en aplicaciones Blazor. Compatible con .NET 9.0 y utiliza Microsoft.AspNetCore.Components.Web para la implementación de componentes web interactivos.</Description>
		<Version>2025.09.02</Version>
		<AssemblyVersion>2025.09.02</AssemblyVersion>
		<FileVersion>2025.09.02</FileVersion>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<Copyright>Copyright © David Vázquez Palestino</Copyright>
		<PackageId>DevKit.Shared.RazorComponent</PackageId>
		<PackageOutputPath>C:\Github\Packages\DevKit.Shared.Razor</PackageOutputPath>
		<PackageIcon>102042_tools_icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.8" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Imagenes\102042_tools_icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="Imagenes\102042_tools_icon.png">
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<Pack>True</Pack>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="LICENSE">
			<Pack>True</Pack>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>


</Project>
