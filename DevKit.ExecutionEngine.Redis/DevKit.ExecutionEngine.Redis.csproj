<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Company>David Vázquez Palestino</Company>
		<Product>DevKit.ExecutionEngine.Redis</Product>
		<LangVersion>latest</LangVersion>
		<Copyright>Copyright David Vázquez Palestino</Copyright>
		<AssemblyVersion>2026.02.27</AssemblyVersion>
		<FileVersion>2026.02.27</FileVersion>
		<Version>2026.02.27</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<Title>DevKit.ExecutionEngine.Redis - Biblioteca de Caché para Redis</Title>
		<Authors>David Vázquez Palestino</Authors>
		<Description>DevKit.ExecutionEngine.Redis es una biblioteca para integrar Redis como sistema de caché en aplicaciones .NET. Proporciona métodos asíncronos para almacenar y recuperar datos, con invalidación inteligente basada en expresiones lambda. Compatible con .NET 8.0 y superiores.</Description>
		<PackageId>DevKit.ExecutionEngine.Redis</PackageId>
		<PackageOutputPath>C:\Github\Packages\RedisCache</PackageOutputPath>
		<PackageIcon>102042_tools_icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>redis cache dotnet async lambda</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
		<PackageReference Include="StackExchange.Redis" Version="2.10.1" />
	</ItemGroup>


	<ItemGroup>
		<None Include="Imagenes\102042_tools_icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="Imagenes\102042_tools_icon.png">
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<Pack>True</Pack>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<None Update="LICENSE">
			<Pack>True</Pack>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>




</Project>
