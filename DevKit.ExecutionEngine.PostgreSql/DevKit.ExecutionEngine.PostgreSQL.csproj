<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net9.0;net10.0;</TargetFrameworks>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<PropertyGroup>
		<Company>David Vázquez Palestino</Company>
		<Product>ExecutionEnginePostgreSQL</Product>
		<LangVersion>latest</LangVersion>
		<Copyright>Copyright David Vázquez Palestino</Copyright>
		<AssemblyVersion>2025.11.11</AssemblyVersion>
		<FileVersion>2025.11.11</FileVersion>
		<Version>2025.11.11</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<Title>ExecutionEnginePostgreSQL - Biblioteca de Integración para PostgreSQL y Npgsql</Title>
		<Authors>David Vázquez Palestino</Authors>
		<Description>ExecutionEnginePostgreSQL es una biblioteca de extensiones y utilidades para Npgsql y PostgreSQL. Proporciona métodos optimizados para la conexión, consulta y manipulación de datos en bases de datos PostgreSQL. Compatible con múltiples versiones de .NET (4.8, 8.0 y 9.0).</Description>
		<PackageId>ExecutionEnginePostgreSQL</PackageId>
		<PackageOutputPath>C:\Github\Packages\ExecutionEnginePostgreSQL</PackageOutputPath>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>postgresql npgsql database orm data-access</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
		<PackageReference Include="Npgsql" Version="9.0.4" />
		<PackageReference Include="System.Threading.Tasks" Version="4.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\DevKit.Extensions\DevKit.Extensions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Imagenes\102042_tools_icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="Imagenes\102042_tools_icon.png">
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>True</Pack>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="README.md">
			<Pack>True</Pack>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Include="LICENSE">
			<Pack>True</Pack>
		</None>
	</ItemGroup>



	<ItemGroup>
		<None Update="LICENSE">
			<Pack>True</Pack>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>



	<ItemGroup>
	  <Folder Include="QueryBuilder\" />
	</ItemGroup>


</Project>
